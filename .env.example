# GitHub repository Secrets; copy from Infisical steammarket /cscheap/docs.
# Only preview/master Actions can publish. Never commit a real .env.
# The user temporarily shares one S3 credential across both document buckets.
CSCHEAP_DOCS_R2_ACCOUNT_ID=
CSCHEAP_DOCS_R2_ACCESS_KEY_ID=
CSCHEAP_DOCS_R2_SECRET_ACCESS_KEY=

# Buckets are fixed in scripts/deployment.mjs, not configured through environment variables:
# preview -> preview-cscheap-docs; master -> cscheap-docs.
# Hosted CI does not connect to Infisical. Rotation must also update repository Secrets.

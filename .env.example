# Inject from Infisical project steammarket, secret path /cscheap/docs.
# staging -> preview-cscheap-docs; prod -> cscheap-docs. Never commit a real .env.
# The user temporarily shares one S3 credential across both document buckets.
CSCHEAP_DOCS_R2_ACCOUNT_ID=
CSCHEAP_DOCS_R2_BUCKET=
CSCHEAP_DOCS_R2_ACCESS_KEY_ID=
CSCHEAP_DOCS_R2_SECRET_ACCESS_KEY=

# Infisical remains authoritative. Copy account/bucket to GitHub Environment Variables,
# S3 credentials to Environment Secrets. Hosted CI does not connect to Infisical.
# Rotation must also update both GitHub Environments; see release-operations.md.

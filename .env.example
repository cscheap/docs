# GitHub repository Secrets for the master workflow (copy from Infisical steammarket /cscheap/docs).
# One Cloudflare API token covers both stores: Workers KV Storage Write + R2 object write on the
# fixed bucket. Never commit a real .env.
CSCHEAP_DOCS_CF_ACCOUNT_ID=
CSCHEAP_DOCS_CF_API_TOKEN=

# Targets are fixed in scripts/deployment.mjs, not configured through environment variables:
# KV namespace cscheap-content (JSON: objects, manifests, pointers, markers) and R2 bucket
# cscheap-content (binary assets). Preview and production are channels inside the same stores.
# Local acceptance (scripts/publish-local-test.mjs) additionally requires DOCS_ALLOW_LOCAL_PUBLISH=1
# and only ever writes under a test/<run-id>/ prefix.

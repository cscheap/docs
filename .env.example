# Inject from Infisical project steammarket, environment dev/staging/prod,
# secret path /cscheap/docs. Do not commit an actual .env file.
CSCHEAP_DOCS_TINA_CLIENT_ID=
CSCHEAP_DOCS_TINA_READ_TOKEN=
# Optional non-secret setting. Defaults to master; select a test branch explicitly.
CSCHEAP_DOCS_TINA_BRANCH=master

# R2 publisher: staging and prod must refer to separate document buckets.
# Object Read & Write restricted to the matching bucket; never a global account key.
CSCHEAP_DOCS_R2_ACCOUNT_ID=
CSCHEAP_DOCS_R2_BUCKET=
CSCHEAP_DOCS_R2_ACCESS_KEY_ID=
CSCHEAP_DOCS_R2_SECRET_ACCESS_KEY=

# CI uses a scoped GitHub OIDC machine identity, never the Infisical admin password.
# Non-secret identity IDs and enable switches belong in GitHub environment/repo variables.
# See docs/architecture/release-operations.md.

{
  "name": "@cscheap/docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "cms:dev": "node scripts/tina.mjs dev --noTelemetry",
    "cms:build": "node scripts/tina.mjs build --noTelemetry",
    "cms:build:local": "node scripts/tina.mjs build --local --skip-cloud-checks --noTelemetry",
    "cms:check": "tsc --noEmit",
    "api:generate": "node scripts/api-reference.mjs",
    "api:check": "node scripts/api-reference.mjs --check",
    "docs:check": "npm run api:check && node scripts/build.mjs",
    "docs:build": "node scripts/build.mjs --release",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run cms:check && npm run docs:check && npm test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tinacms": "3.14.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@tinacms/cli": "4.0.1",
    "@tinacms/mdx": "2.3.0",
    "@types/node": "22.20.5",
    "remark-gfm": "2.0.0",
    "remark-mdx": "2.3.0",
    "remark-parse": "10.0.2",
    "typescript": "5.9.3",
    "unified": "10.1.2",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  }
}
